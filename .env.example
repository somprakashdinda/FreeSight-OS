# ============================================================
# Eye-Tracking Android Controller - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Android / ADB
# ------------------------------------------------------------

# Full path to the ADB executable.
# Leave empty if adb is already available in PATH.
ADB_PATH=

# Android device serial/ID.
# Leave empty to use the first available connected device.
ANDROID_DEVICE_SERIAL=

# ------------------------------------------------------------
# scrcpy
# ------------------------------------------------------------

# Full path to the scrcpy executable.
# Leave empty if scrcpy is already available in PATH.
SCRCPY_PATH=

# scrcpy server executable/jar path, if an explicit path is required.
# Leave empty to let the application use its normal scrcpy location.
SCRCPY_SERVER_PATH=

# Camera used by the eye-tracking pipeline.
# 0 = back camera, 1 = front camera on the tested device.
CAMERA_ID=1

# Camera resolution requested from Android.
# Use a resolution supported by the selected camera.
CAMERA_SIZE=1080x1920

# Camera capture frame rate.
CAMERA_FPS=30

# ------------------------------------------------------------
# Vision / Performance
# ------------------------------------------------------------

# Target processing FPS for the vision pipeline.
TARGET_FPS=30

# Maximum camera/video size used by the application.
MAX_SIZE=1920

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Application logging level.
# Valid examples: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
